        <mxCell id="saga-3-step-3" value="3. Release the slot hold when the hold expires unpaid" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D32F2F;strokeWidth=2;fontColor=#D32F2F;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0.5758;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5758;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="saga-3-1" source="saga-3-appointment-service" target="saga-3-scheduling-service">
